# Copier ce fichier en `.env` pour surcharger les ports publiés.
# Sans `.env`, les valeurs par défaut de docker-compose.yml sont utilisées.

# RPC des 4 validateurs (exposés sur l'hôte)
NODE_0_RPC_PORT=8545
NODE_1_RPC_PORT=8555
NODE_2_RPC_PORT=8565
NODE_3_RPC_PORT=8575

# P2P QUIC des 4 validateurs (exposés sur l'hôte, UDP)
NODE_0_P2P_PORT=9000
NODE_1_P2P_PORT=9001
NODE_2_P2P_PORT=9002
NODE_3_P2P_PORT=9003

# Services annexes
FAUCET_PORT=3001
EXPLORER_PORT=8090

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3006
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
